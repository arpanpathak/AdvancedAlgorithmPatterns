<!--
  MathJax configuration: mdBook 0.5 does not emit the tex2jax config by default,
  so $...$ / $$...$$ delimiters would never activate. This file is merged into
  <head> (mdBook keeps its own MathJax script; book.js additionally forces a
  PreProcess + Typeset pass after load so rendering never races the loader).
-->
<script type="text/x-mathjax-config">
MathJax.Hub.Config({
  tex2jax: {
    inlineMath: [['$', '$'], ['\\(', '\\)']],
    displayMath: [['$$', '$$'], ['\\[', '\\]']],
    processEscapes: true
  }
});
</script>
